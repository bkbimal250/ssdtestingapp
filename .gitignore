# Generated build, publish and release outputs
[Bb]in/
[Oo]bj/
node_modules/
dist/
out/
release/
artifacts/
publish/
[Bb]uild/
installer/

# Required release source files are not generated outputs.
!/build/
/build/*
!/build/*.ps1
!/installer/
/installer/*
!/installer/*.iss

# Generated executables, native libraries, symbols and packages.
# No checked-in binary dependency is required by the current WPF projects.
*.exe
*.msi
*.msix
*.msixbundle
*.appx
*.appxbundle
*.dll
*.pyd
*.pdb
*.nupkg
*.snupkg
*.zip
*.7z
*.tar
*.gz
*.Publish.xml
*.publishsettings
packages/
# Keep NuGet.Config, .nuget configuration and all package lock files eligible.

# Local environment/secrets; example templates are safe to track.
.env
.env.*
!.env.example
!.env.*.example
secrets.json

# Generated logs, caches and test results
*.log
.cache/
.vite/
coverage/
TestResults/
*.trx
*.coverage
coverage.opencover.xml
__pycache__/
*.py[cod]
*.egg-info/

# Local IDE state
.vs/
.vscode/
.idea/
_ReSharper*/
*.DotSettings.user
*.suo
*.user
*.userosscache
*.sln.docstates
.history/
.vsdbg*/

# Runtime databases; source migrations and schema files stay eligible.
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# OS metadata and temporary files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
~$*

# Generated historical verification output and machine-specific telemetry.
# Keep written validation documents, observations and documentation screenshots.
/docs/verification-output.txt
/docs/phase-*-baseline-output.txt
/docs/phase-*-behavior-output.txt
/docs/phase-*-hardware-output.txt
/docs/phase-*-verification-output.txt
/docs/phase-5-intel-nvme.json
/docs/phase-5-intel-nvme.txt
/docs/phase-6-intel-nvme-benchmark.json
/docs/phase-6-intel-nvme-benchmark.txt
