<UserControl x:Class="pixinit.Views.Nvme.NvmeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="clr-namespace:pixinit.Views.Shared">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/pixinit;component/Resources/Styles/Diagnostics.xaml"/></ResourceDictionary.MergedDictionaries><Style x:Key="DetailsCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E5E7EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
<Style x:Key="DetailsHeader" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
<Style x:Key="DetailsValue" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,4"/></Style>
<Style x:Key="DetailsExpander" TargetType="Expander"><Setter Property="IsExpanded" Value="True"/><Setter Property="Margin" Value="0,4,0,4"/></Style>
<DataTemplate x:Key="DetailRow"><Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8" Margin="0,0,8,8"><StackPanel><TextBlock Text="{Binding Label}" FontFamily="Segoe UI" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock Text="{Binding Value}" Style="{StaticResource DetailsValue}"/></StackPanel></Border></DataTemplate>
<DataTemplate x:Key="RequestRow"><Border Background="#F9FAFB" CornerRadius="6" Padding="8" Margin="0,0,8,8"><StackPanel><TextBlock Text="{Binding Label}" FontSize="12"/><DockPanel><Ellipse Width="7" Height="7" Fill="{Binding Color}" Margin="0,0,6,0"/><TextBlock Text="{Binding Value}" Style="{StaticResource DetailsValue}"/></DockPanel></StackPanel></Border></DataTemplate></ResourceDictionary></UserControl.Resources>
  <Grid Margin="12,10,12,6">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource DiagnosticCard}" Padding="12" BorderBrush="#E5E7EB" Margin="0,0,0,10" HorizontalAlignment="Stretch">
      <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,0,0,0" Content="Read NVMe Diagnostics" Command="{Binding DataContext.ReadNvmeCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Read NVMe Diagnostics"/>
        <StackPanel>
          <TextBlock Text="{Binding Device.ProtocolEvidence}" TextWrapping="Wrap" Foreground="#92400E" FontSize="12" Margin="0,0,0,6"/><TextBlock Text="{Binding Model}" TextWrapping="NoWrap" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}"/>
          <TextBlock Text="{Binding LinkDisplay}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Serial, StringFormat=Serial: {0}}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding DataContext.NvmeOperationStatus, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <TabControl Background="#F7F9FC" BorderThickness="0" Grid.Row="1" HorizontalAlignment="Stretch" AutomationProperties.Name="NVMe sections">
      <TabItem Header="_Overview"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8,12,8,4"><shared:FirstPageView DiagnosticCommand="{Binding DataContext.ReadNvmeCommand, RelativeSource={RelativeSource AncestorType=Window}}"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="S_MART">
        <ScrollViewer x:Name="SmartViewport" Margin="8,12,8,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="300" Height="{Binding ActualHeight, ElementName=SmartViewport}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Style="{StaticResource DiagnosticCard}"><StackPanel><TextBlock Text="NVMe SMART / Health" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Scope}" Style="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock Text="Exact counters from the health log. Zero data units mean not reported; other zero counters may be valid." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
          <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="1"><DataGrid ItemsSource="{Binding SmartReadings}" AutomationProperties.Name="NVMe SMART health fields" MinHeight="120" HeadersVisibility="Column" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn Header="Health field" Binding="{Binding Field}" Width="1.1*" MinWidth="145"/><DataGridTextColumn Header="Reported value" Binding="{Binding Value}" Width="1.25*" MinWidth="170"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Unit / meaning" Binding="{Binding Unit}" Width="1*" MinWidth="145"/></DataGrid.Columns></DataGrid></Border>
          <Expander Grid.Row="2" Header="Warning bits and source details" Margin="0,10,0,0" Padding="8" Background="White"><ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding WarningDetails}" Style="{StaticResource Muted}" Margin="8"/></ScrollViewer></Expander>
        </Grid></ScrollViewer>
      </TabItem>
            <TabItem Header="_Details"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8,12,8,4" TextElement.FontFamily="Segoe UI">
        <Border Style="{StaticResource DetailsCard}"><StackPanel><TextBlock Text="Request outcomes and scope" Style="{StaticResource DetailsHeader}"/><ItemsControl ItemsSource="{Binding RequestRows}" ItemTemplate="{StaticResource RequestRow}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><TextBlock Text="{Binding Scope}" Style="{StaticResource DetailsValue}"/><DockPanel><Ellipse Width="7" Height="7" Fill="{Binding CriticalWarningColor}" Margin="0,0,6,0"/><TextBlock Text="{Binding CriticalWarningRaw, StringFormat=Critical Warning raw: {0}}" Style="{StaticResource DetailsValue}"/></DockPanel><Expander Header="Request provenance" Style="{StaticResource DetailsExpander}"><TextBlock Text="{Binding QuerySummary}" Style="{StaticResource DetailsValue}"/></Expander></StackPanel></Border>
        <Border Style="{StaticResource DetailsCard}"><StackPanel><TextBlock Text="Exact usage counters" Style="{StaticResource DetailsHeader}"/><Expander Header="View exact usage counters" Style="{StaticResource DetailsExpander}"><DataGrid ItemsSource="{Binding ExactCounterRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" FontFamily="Consolas" FontSize="12" EnableRowVirtualization="True" MaxHeight="330" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn Header="Counter" Binding="{Binding Field}" Width="2*"/><DataGridTextColumn Header="Exact value / reason" Binding="{Binding Value}" Width="2*"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="2*"/></DataGrid.Columns></DataGrid></Expander><Expander Header="Counter methodology and provenance" Style="{StaticResource DetailsExpander}"><ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Usage}" Style="{StaticResource DetailsValue}"/></ScrollViewer></Expander></StackPanel></Border>
        <Border Style="{StaticResource DetailsCard}"><StackPanel><TextBlock Text="Thermal information" Style="{StaticResource DetailsHeader}"/><WrapPanel><Border Background="#F3F4F6" CornerRadius="6" Padding="8,4" Margin="0,0,8,8"><TextBlock Text="{Binding ReportedSensors}"/></Border><Border Background="#F3F4F6" CornerRadius="6" Padding="8,4" Margin="0,0,8,8"><TextBlock Text="{Binding NotImplementedSensors}"/></Border><Border Background="#F3F4F6" CornerRadius="6" Padding="8,4" Margin="0,0,8,8"><TextBlock Text="{Binding UnavailableSensors}"/></Border></WrapPanel><TextBlock Text="Counts refer to individual sensors only. Composite temperature is an independent SMART/Health field. Zero raw sensor fields mean not implemented by the controller." TextWrapping="Wrap" Foreground="#64748B" FontSize="12"/><ItemsControl ItemsSource="{Binding ThermalRows}" ItemTemplate="{StaticResource DetailRow}"/><Expander Header="Individual sensor fields" Style="{StaticResource DetailsExpander}"><ItemsControl ItemsSource="{Binding SensorRows}" ItemTemplate="{StaticResource RequestRow}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></Expander><Expander Header="Thermal management and raw evidence" Style="{StaticResource DetailsExpander}"><ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Thermal}" Style="{StaticResource DetailsValue}"/></ScrollViewer></Expander></StackPanel></Border>
        <Border Style="{StaticResource DetailsCard}"><StackPanel><TextBlock Text="Controller and namespace" Style="{StaticResource DetailsHeader}"/><Expander Header="View controller and namespace" Style="{StaticResource DetailsExpander}"><StackPanel><ItemsControl ItemsSource="{Binding ControllerRows}" ItemTemplate="{StaticResource DetailRow}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><Border Background="#FFFBEB" CornerRadius="6" Padding="8"><TextBlock Text="{Binding IdentityStatus}" TextWrapping="Wrap" Foreground="#854D0E" FontSize="12"/></Border><TextBlock Text="{Binding NamespaceDisclosure}" Style="{StaticResource DetailsValue}"/><TextBlock Text="{Binding LinkDisplay}" Style="{StaticResource DetailsValue}"/><Expander Header="Full controller and namespace evidence" Style="{StaticResource DetailsExpander}"><ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Controller}" Style="{StaticResource DetailsValue}"/></ScrollViewer></Expander></StackPanel></Expander><Expander Header="Windows discovery details" Style="{StaticResource DetailsExpander}"><TextBlock Text="{Binding DiscoveryDetails}" Style="{StaticResource DetailsValue}"/></Expander></StackPanel></Border>
        <Border Style="{StaticResource DetailsCard}"><StackPanel><TextBlock Text="Error information" Style="{StaticResource DetailsHeader}"/><ItemsControl ItemsSource="{Binding ErrorRows}" ItemTemplate="{StaticResource DetailRow}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><Expander Header="View error information" Style="{StaticResource DetailsExpander}"><TextBlock Text="{Binding Errors}" Style="{StaticResource DetailsValue}"/></Expander></StackPanel></Border>
        <Border Style="{StaticResource DetailsCard}"><Expander Header="Technical assessment details" Style="{StaticResource DetailsExpander}"><TextBlock Text="{Binding AssessmentDetails}" Style="{StaticResource DetailsValue}"/></Expander></Border>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
  </Grid>
</UserControl>
