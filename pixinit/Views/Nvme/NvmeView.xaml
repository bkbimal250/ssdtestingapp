<UserControl x:Class="pixinit.Views.Nvme.NvmeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="clr-namespace:pixinit.Views.Shared" SizeChanged="OnSizeChanged">
  <Grid Margin="18,14,18,8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="12" BorderBrush="{StaticResource NvmeBrush}" Margin="0,0,0,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Read NVMe Diagnostics" Command="{Binding DataContext.ReadNvmeCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Read NVMe Diagnostics"/>
        <StackPanel>
          <TextBlock Text="{Binding Model}" TextWrapping="NoWrap" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}"/>
          <TextBlock Text="{Binding Serial, StringFormat=Serial: {0}}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Connection}" Style="{StaticResource Muted}"/>
          <TextBlock Text="{Binding DataContext.NvmeOperationStatus, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <TabControl Grid.Row="1" AutomationProperties.Name="NVMe sections">
      <TabItem Header="_Overview">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="2,12,2,4">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel>
              <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ObservedLocal, StringFormat=Observed locally: {0}}" Style="{StaticResource Muted}"/><TextBlock Text="Assessment" Style="{StaticResource Heading}"/></DockPanel>
              <TextBlock Text="{Binding Assessment}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Coverage}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel></Border>
            <UniformGrid x:Name="Metrics" Columns="4">
              <shared:MetricCard Label="Critical warning" Value="{Binding CriticalWarning}"/>
              <shared:MetricCard Label="Temperature" Value="{Binding Temperature}"/>
              <shared:MetricCard Label="Available spare" Value="{Binding AvailableSpare}"/>
              <shared:MetricCard Label="Endurance consumed" Value="{Binding PercentageUsed}"/>
            </UniformGrid>
            <TextBlock Text="Percentage Used is consumed endurance, not remaining health." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Text="Host reads" Style="{StaticResource Muted}" Margin="0,3,18,3"/><TextBlock Grid.Column="1" Text="{Binding HostReads}" FontWeight="SemiBold" Margin="0,3,28,3"/>
              <TextBlock Grid.Column="2" Text="Host writes" Style="{StaticResource Muted}" Margin="0,3,18,3"/><TextBlock Grid.Column="3" Text="{Binding HostWrites}" FontWeight="SemiBold" Margin="0,3"/>
              <TextBlock Grid.Row="1" Text="Power-on time" Style="{StaticResource Muted}" Margin="0,3,18,3"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PowerOnHours}" FontWeight="SemiBold" Margin="0,3,28,3"/>
              <TextBlock Grid.Row="1" Grid.Column="2" Text="Power cycles" Style="{StaticResource Muted}" Margin="0,3,18,3"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PowerCycles}" FontWeight="SemiBold" Margin="0,3"/>
              <TextBlock Grid.Row="2" Text="Unsafe shutdowns" Style="{StaticResource Muted}" Margin="0,3,18,3"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UnsafeShutdowns}" FontWeight="SemiBold" Margin="0,3,28,3"/>
              <TextBlock Grid.Row="2" Grid.Column="2" Text="Media errors" Style="{StaticResource Muted}" Margin="0,3,18,3"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding MediaErrors}" FontWeight="SemiBold" Margin="0,3"/>
            </Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Identity and warnings" Style="{StaticResource Heading}"/><TextBlock Text="{Binding IdentityStatus}" TextWrapping="Wrap"/><TextBlock Text="{Binding WarningDetails}" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border>
            <TextBlock Text="{Binding DataStatus}" Style="{StaticResource Muted}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="_Details">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="2,12,2,4">
          <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Request outcomes and scope" Style="{StaticResource Heading}"/><TextBlock Text="{Binding QuerySummary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Scope}" Style="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock Text="{Binding CriticalWarningRaw, StringFormat=Critical Warning raw value: {0}}" Style="{StaticResource Muted}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Exact usage counters" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Usage}" Style="{StaticResource Muted}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Thermal information" Style="{StaticResource Heading}"/><TextBlock Text="{Binding ThermalSummary}"/><Expander Header="Individual sensor fields"><TextBlock Text="{Binding Thermal}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></Expander></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Controller and namespace" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Controller}" Style="{StaticResource Muted}"/><Expander Header="Windows discovery details"><TextBlock Text="{Binding DiscoveryDetails}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></Expander></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Error information" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Errors}" Style="{StaticResource Muted}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><Expander Header="Technical assessment details"><TextBlock Text="{Binding AssessmentDetails}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></Expander></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="_Raw Data">
        <Grid Margin="2,12,2,4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Raw protocol responses · may contain the full device serial" Style="{StaticResource Muted}" Margin="0,0,0,8"/><TextBox Grid.Row="1" Text="{Binding RawDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Raw NVMe diagnostics"/></Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
