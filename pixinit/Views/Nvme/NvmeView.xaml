<UserControl x:Class="pixinit.Views.Nvme.NvmeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="clr-namespace:pixinit.Views.Shared" SizeChanged="OnSizeChanged">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18,14,18,8">
      <Border Style="{StaticResource Card}" Padding="12" BorderBrush="{StaticResource NvmeBrush}">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Read NVMe Diagnostics" Command="{Binding DataContext.ReadNvmeCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Read NVMe Diagnostics" />
            <TextBlock Text="{Binding DataContext.NvmeOperationStatus, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{Binding Model}" FontSize="21" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}" />
          <TextBlock Text="{Binding Serial, StringFormat=Serial: {0}}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Serial}" />
          <TextBlock Text="{Binding Connection}" Style="{StaticResource Muted}" />
        </StackPanel>
      </Border>
      <UniformGrid x:Name="Metrics" Columns="4">
        <shared:MetricCard Label="Critical Warning" Value="{Binding CriticalWarning}" />
        <shared:MetricCard Label="Temperature" Value="{Binding Temperature}" />
        <shared:MetricCard Label="Available Spare" Value="{Binding AvailableSpare}" />
        <shared:MetricCard Label="Percentage Used" Value="{Binding PercentageUsed}" />
      </UniformGrid>
      <TextBlock Text="Percentage Used is the NVMe-reported estimate of endurance consumed, not remaining health." Style="{StaticResource Muted}" Margin="0,0,0,14" />
      <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Application assessment / diagnostic checklist" Style="{StaticResource Heading}" /><TextBlock Text="{Binding Assessment}" FontWeight="SemiBold" TextWrapping="Wrap" /><Expander Header="Evidence, checks and missing inputs"><TextBlock Text="{Binding AssessmentDetails}" Style="{StaticResource Muted}" Margin="0,8,0,0" /></Expander></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="Critical Warning indicators" Style="{StaticResource Heading}" />
        <TextBlock Text="{Binding WarningDetails}" Style="{StaticResource Muted}" />
        <TextBlock Text="{Binding SpareThreshold, StringFormat=Available Spare Threshold: {0}}" Style="{StaticResource Muted}" />
      </StackPanel></Border>
      <UniformGrid x:Name="Sections" Columns="2">
        <Border Style="{StaticResource Card}" Margin="0,0,10,12">
          <StackPanel>
            <TextBlock Text="Usage counters" Style="{StaticResource Heading}" />
            <TextBlock Text="{Binding Usage}" Style="{StaticResource Muted}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,10,12">
          <StackPanel>
            <TextBlock Text="Thermal information" Style="{StaticResource Heading}" />
            <TextBlock Text="{Binding Thermal}" Style="{StaticResource Muted}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,10,12">
          <StackPanel>
            <TextBlock Text="Controller / namespace" Style="{StaticResource Heading}" />
            <Expander Header="Reported device information" AutomationProperties.Name="NVMe discovery details">
              <TextBlock Text="{Binding DiscoveryDetails}" Style="{StaticResource Muted}" Margin="0,8,0,10" />
            </Expander>
            <TextBlock Text="{Binding Controller}" Style="{StaticResource Muted}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,10,12">
          <StackPanel>
            <TextBlock Text="Error information" Style="{StaticResource Heading}" />
            <TextBlock Text="{Binding Errors}" Style="{StaticResource Muted}" />
          </StackPanel>
        </Border>
      </UniformGrid>
      <Expander Header="Raw NVMe diagnostics · contains device serial" AutomationProperties.Name="Raw NVMe diagnostics">
        <TextBox Text="{Binding RawDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" MaxHeight="300" VerticalScrollBarVisibility="Auto" />
      </Expander>
      <TextBlock Text="{Binding DataStatus}" Style="{StaticResource Muted}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
