<UserControl x:Class="pixinit.Views.Shared.FirstPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:pixinit.Views.Shared" FontFamily="Segoe UI">
<UserControl.Resources><Style x:Key="FirstCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE3ED"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,0,0,10"/></Style><DataTemplate x:Key="InfoRowTemplate"><Border BorderBrush="#DCE3ED" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,12,0"><StackPanel><TextBlock Text="{Binding Label}" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="#17243B"/></StackPanel></Border></DataTemplate></UserControl.Resources>
<StackPanel>
<Border Style="{StaticResource FirstCard}"><StackPanel><DockPanel><ComboBox DockPanel.Dock="Right" Width="120" MinWidth="120" MaxWidth="120" Margin="12,0,4,0" ItemsSource="{Binding VolumeChoices}" SelectedItem="{Binding SelectedVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Selected mounted volume"/><TextBlock Text="Storage Usage" FontSize="15" FontWeight="SemiBold"/></DockPanel>
<Border Margin="0,6" Padding="8" CornerRadius="4"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding HasNoVolumes}" Value="True"><Setter Property="Background" Value="#FFF8E1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StorageStatusText}" TextWrapping="Wrap" Foreground="#64748B" AutomationProperties.LiveSetting="Polite"/></Border>
<ProgressBar Value="{Binding UsedPercent, Mode=OneWay, TargetNullValue=0}" Maximum="100" Height="10" Margin="0,6"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasStorageUsage}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><TextBlock Text="{Binding UsedPercentDisplay}" FontFamily="Consolas"/>
<UniformGrid Columns="3" Margin="0,8,0,0"><StackPanel><TextBlock Text="Total" Foreground="#64748B"/><TextBlock Text="{Binding TotalStorageDisplay}" FontFamily="Consolas" TextWrapping="Wrap"/></StackPanel><StackPanel><TextBlock Text="Used" Foreground="#64748B"/><TextBlock Text="{Binding UsedStorageDisplay}" FontFamily="Consolas" TextWrapping="Wrap"/></StackPanel><StackPanel><TextBlock Text="Free (available)" Foreground="#64748B"/><TextBlock Text="{Binding FreeStorageDisplay}" FontFamily="Consolas" TextWrapping="Wrap"/></StackPanel></UniformGrid>
</StackPanel></Border>
<Border Style="{StaticResource FirstCard}"><StackPanel><TextBlock Text="Entire SSD Info" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding EntireSsdInfo}" ItemTemplate="{StaticResource InfoRowTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><TextBlock Text="{Binding CrystalSummary}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding SmartTable}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>

<Border Style="{StaticResource FirstCard}"><StackPanel><TextBlock Text="Assessment" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="{Binding Assessment}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Coverage}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,4,0,0"/><TextBlock Text="{Binding ObservedLocal, StringFormat=Observed locally: {0}}" Foreground="#64748B" Margin="0,4,0,0"/><TextBlock Text="{Binding FirstPageWarnings}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
</StackPanel></UserControl>
