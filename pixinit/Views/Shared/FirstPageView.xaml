<UserControl x:Class="pixinit.Views.Shared.FirstPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:pixinit.Views.Shared" FontFamily="Segoe UI">
<UserControl.Resources><Style x:Key="FirstCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E5E7EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/></Style><DataTemplate x:Key="InfoRowTemplate"><Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,12,0"><DockPanel><Button DockPanel.Dock="Right" Content="Run Diagnostics" HorizontalAlignment="Right" VerticalAlignment="Center" MinHeight="0" Padding="5,2" FontSize="11" Margin="6,0,0,0" Visibility="{Binding NeedsDiagnostics, Converter={StaticResource BoolVisibility}}" Command="{Binding DiagnosticCommand, RelativeSource={RelativeSource AncestorType=local:FirstPageView}}"/><StackPanel><TextBlock Text="{Binding Label}" Foreground="#64748B" FontSize="12"/><TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="13"/></StackPanel></DockPanel></Border></DataTemplate></UserControl.Resources>
<StackPanel>
<Border Style="{StaticResource FirstCard}"><StackPanel><DockPanel><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Volumes}" SelectedItem="{Binding SelectedVolume}" MinWidth="90" AutomationProperties.Name="Selected mounted volume"><ComboBox.Style><Style TargetType="ComboBox"><Style.Triggers><DataTrigger Binding="{Binding Volumes.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox><TextBlock Text="Storage Usage" FontSize="17" FontWeight="SemiBold"/></DockPanel>
<TextBlock Text="{Binding StorageStatusText}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,6"/>
<ProgressBar Value="{Binding UsedPercent, Mode=OneWay, TargetNullValue=0}" Maximum="100" Height="10" Margin="0,6"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasStorageUsage}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><TextBlock Text="{Binding UsedPercentDisplay}" FontFamily="Consolas"/>
<UniformGrid Columns="3" Margin="0,8,0,0"><StackPanel><TextBlock Text="Total" Foreground="#64748B"/><TextBlock Text="{Binding TotalStorageDisplay}" FontFamily="Consolas" TextWrapping="Wrap"/></StackPanel><StackPanel><TextBlock Text="Used" Foreground="#64748B"/><TextBlock Text="{Binding UsedStorageDisplay}" FontFamily="Consolas" TextWrapping="Wrap"/></StackPanel><StackPanel><TextBlock Text="Free (available)" Foreground="#64748B"/><TextBlock Text="{Binding FreeStorageDisplay}" FontFamily="Consolas" TextWrapping="Wrap"/></StackPanel></UniformGrid>
</StackPanel></Border>
<Border Style="{StaticResource FirstCard}"><StackPanel><TextBlock Text="Entire SSD Info" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ContentControl Grid.Row="0" Grid.Column="0" Content="{Binding EntireSsdInfo[0]}" ContentTemplate="{StaticResource InfoRowTemplate}"/><ContentControl Grid.Row="1" Grid.Column="0" Content="{Binding EntireSsdInfo[1]}" ContentTemplate="{StaticResource InfoRowTemplate}"/><ContentControl Grid.Row="2" Grid.Column="0" Content="{Binding EntireSsdInfo[2]}" ContentTemplate="{StaticResource InfoRowTemplate}"/><ContentControl Grid.Row="3" Grid.Column="0" Content="{Binding EntireSsdInfo[3]}" ContentTemplate="{StaticResource InfoRowTemplate}"/><ContentControl Grid.Row="4" Grid.Column="0" Content="{Binding EntireSsdInfo[4]}" ContentTemplate="{StaticResource InfoRowTemplate}"/><ContentControl Grid.Row="5" Grid.Column="0" Content="{Binding EntireSsdInfo[5]}" ContentTemplate="{StaticResource InfoRowTemplate}"/><ContentControl Grid.Row="6" Grid.Column="0" Content="{Binding EntireSsdInfo[6]}" ContentTemplate="{StaticResource InfoRowTemplate}"/><ContentControl Grid.Row="7" Grid.Column="0" Content="{Binding EntireSsdInfo[7]}" ContentTemplate="{StaticResource InfoRowTemplate}"/><ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding EntireSsdInfo[8]}" ContentTemplate="{StaticResource InfoRowTemplate}"/><ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding EntireSsdInfo[9]}" ContentTemplate="{StaticResource InfoRowTemplate}"/><ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding EntireSsdInfo[10]}" ContentTemplate="{StaticResource InfoRowTemplate}"/><ContentControl Grid.Row="3" Grid.Column="1" Content="{Binding EntireSsdInfo[11]}" ContentTemplate="{StaticResource InfoRowTemplate}"/><ContentControl Grid.Row="4" Grid.Column="1" Content="{Binding EntireSsdInfo[12]}" ContentTemplate="{StaticResource InfoRowTemplate}"/><ContentControl Grid.Row="5" Grid.Column="1" Content="{Binding EntireSsdInfo[13]}" ContentTemplate="{StaticResource InfoRowTemplate}"/><ContentControl Grid.Row="6" Grid.Column="1" Content="{Binding EntireSsdInfo[14]}" ContentTemplate="{StaticResource InfoRowTemplate}"/><ContentControl Grid.Row="7" Grid.Column="1" Content="{Binding EntireSsdInfo[15]}" ContentTemplate="{StaticResource InfoRowTemplate}"/></Grid></StackPanel></Border>
<Border Style="{StaticResource FirstCard}"><local:ThermalCaptureView/></Border>
<Border Style="{StaticResource FirstCard}"><StackPanel><TextBlock Text="{Binding Assessment}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Coverage}" TextWrapping="Wrap" Foreground="#64748B"/><TextBlock Text="{Binding ObservedLocal, StringFormat=Observed locally: {0}}" Foreground="#64748B"/><TextBlock Text="{Binding FirstPageWarnings}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
</StackPanel></UserControl>
