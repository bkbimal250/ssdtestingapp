<UserControl x:Class="pixinit.Views.Shared.MetricCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
  <Border Style="{StaticResource Card}" Margin="0,0,10,10" MinHeight="72" Padding="12">
    <StackPanel><Border Width="24" Height="3" Background="#91A9C9" CornerRadius="2" HorizontalAlignment="Left" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource Muted}" />
      <TextBlock Text="{Binding Value, ElementName=Root}" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
    </StackPanel>
  </Border>
</UserControl>