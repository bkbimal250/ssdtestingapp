<UserControl x:Class="pixinit.Views.Benchmark.BenchmarkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<UserControl.Resources><Style x:Key="BenchmarkCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="BorderBrush" Value="#E5E7EB"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="16"/></Style><Style TargetType="CheckBox"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/></Style><Style TargetType="ComboBox"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/></Style></UserControl.Resources>
<StackPanel>
<TextBlock Text="Performance benchmark" Style="{StaticResource Heading}"/>
<TextBlock Text="Buffered filesystem benchmark - QD1; caching affects results." Style="{StaticResource Muted}" Margin="0,4,0,12"/>
<Border Style="{StaticResource BenchmarkCard}" Padding="12"><StackPanel>
<DockPanel><Button DockPanel.Dock="Right" Content="Browse target..." Command="{Binding BrowseCommand}" Margin="8,0,0,0"/><TextBlock Text="Target folder" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding TargetDirectory}"/></DockPanel>
<WrapPanel Margin="0,10,0,8"><TextBlock Text="File size (MiB)" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding FileSizes}" SelectedItem="{Binding FileSizeMiB}" Width="90" Margin="8,0,16,0"/><CheckBox Content="Include writes" IsChecked="{Binding IncludeWrites}" Margin="0,0,16,0"/><CheckBox Content="Include Random (4 KiB, 1000 I/Os)" IsChecked="{Binding IncludeRandom}" Margin="0,0,16,0"/><CheckBox Content="Include Sustained" IsChecked="{Binding SustainedWrite}" Margin="0,0,12,0"/><ComboBox ItemsSource="{Binding Durations}" SelectedItem="{Binding SustainedDurationSeconds}" Width="64"/><TextBlock Text="seconds" Margin="8,0" VerticalAlignment="Center"/></WrapPanel>
<TextBlock Text="{Binding ConfigurationSummary}" TextWrapping="Wrap"/><Expander Header="Write limits and free-space reserve" Margin="0,6,0,0"><TextBlock Margin="0,6,0,0" Text="Ordinary writes are capped at 3 GiB including read preparation and random writes. Ordinary reserve: 3 GiB or 10% free space, whichever is greater. Sustained uses a separate 32 GiB cap and a 1 GiB circular file; sustained-only reserve: 1 GiB or 10%." Style="{StaticResource Muted}"/></Expander>
<Grid Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Start benchmark" Command="{Binding StartCommand}" MinWidth="138"/><Button Grid.Column="1" Content="Cancel benchmark" Command="{Binding CancelCommand}" Margin="8,0,16,0" MinWidth="138"/><TextBlock Grid.Column="2" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid>
<ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6"/><TextBlock Text="{Binding CurrentOperation}" Margin="0,8,0,4"/><TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource Muted}"/>
<TextBlock Text="{Binding ConsentStatus}" Style="{StaticResource Muted}"/>
</StackPanel></Border>
<UniformGrid Columns="5" Margin="0,16,0,4">
<Border Style="{StaticResource BenchmarkCard}" Padding="14" Margin="0,0,8,8" MinHeight="116"><StackPanel><TextBlock Text="Sequential read" FontWeight="SemiBold"/><TextBlock Text="{Binding SequentialReadResult, TargetNullValue=Unavailable}" FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<Border Style="{StaticResource BenchmarkCard}" Padding="14" Margin="0,0,8,8" MinHeight="116"><StackPanel><TextBlock Text="Sequential write" FontWeight="SemiBold"/><TextBlock Text="{Binding SequentialWriteResult, TargetNullValue=Unavailable}" FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<Border Style="{StaticResource BenchmarkCard}" Padding="14" Margin="0,0,8,8" MinHeight="116"><StackPanel><TextBlock Text="Random read" FontWeight="SemiBold"/><TextBlock Text="{Binding RndReadIOPS, StringFormat={}{0:F1} IOPS, TargetNullValue=Unavailable}" FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding RndReadMBs, StringFormat={}{0:F2} MiB/s, TargetNullValue=Unavailable}" FontFamily="Consolas"/><TextBlock Text="1000 / mean latency (ms)" Style="{StaticResource Muted}"/></StackPanel></Border>
<Border Style="{StaticResource BenchmarkCard}" Padding="14" Margin="0,0,8,8" MinHeight="116"><StackPanel><TextBlock Text="Random write" FontWeight="SemiBold"/><TextBlock Text="{Binding RndWriteIOPS, StringFormat={}{0:F1} IOPS, TargetNullValue=Unavailable}" FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding RndWriteMBs, StringFormat={}{0:F2} MiB/s, TargetNullValue=Unavailable}" FontFamily="Consolas"/><TextBlock Text="1000 / mean latency (ms)" Style="{StaticResource Muted}"/></StackPanel></Border>
<Border Style="{StaticResource BenchmarkCard}" Padding="14" Margin="0,0,8,8" MinHeight="116"><StackPanel><TextBlock Text="Sustained average" FontWeight="SemiBold"/><TextBlock Text="{Binding SustainedOverallDisplay}" FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding SustainedPostDropDisplay}" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,4,0,0"/><TextBlock Text="{Binding SustainedResult}" Style="{StaticResource Muted}"/></StackPanel></Border>
</UniformGrid>
<Button Content="Run Diagnostics Now" Command="{Binding RunDiagnosticsNowCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="{Binding DiagnosticsMissing, Converter={StaticResource BoolVisibility}}"/>
<UniformGrid Columns="2">
<Border Style="{StaticResource BenchmarkCard}" Padding="12" Margin="0,0,8,8"><StackPanel><TextBlock Text="TBW / host writes" FontWeight="SemiBold"/><TextBlock Text="{Binding TbwDisplay}" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0"/><ProgressBar Value="{Binding TbwRemaining, Mode=OneWay}" Maximum="100" Height="8" Margin="0,8"><ProgressBar.Style><Style TargetType="ProgressBar"><Style.Triggers><DataTrigger Binding="{Binding Tbw.RemainingPercent}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><TextBlock Text="{Binding Tbw.RemainingPercent, StringFormat=Reference remaining: {0:F1}%, TargetNullValue=Reference allowance unavailable, FallbackValue=Reference allowance unavailable}"/><TextBlock Text="{Binding TbwState}"/><TextBlock Text="600 TB is an unverified reference, not a device rating or remaining health." Style="{StaticResource Muted}"/></StackPanel></Border>
<Border Style="{StaticResource BenchmarkCard}" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="Temperature" FontWeight="SemiBold"/><DockPanel Margin="0,8,0,0"><Ellipse Fill="{Binding TemperatureColor}" Width="10" Height="10" Margin="0,0,8,0"/><TextBlock Text="{Binding TemperatureDisplay}" TextWrapping="Wrap"/></DockPanel><Grid Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding IdleTemperatureDisplay}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,8"/><Button Grid.Column="1" Content="Capture Idle" Command="{Binding CaptureIdleCommand}" MinWidth="112" Margin="0,0,0,8"/><TextBlock Grid.Row="1" Text="{Binding LoadTemperatureDisplay}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Grid.Row="1" Grid.Column="1" Content="Capture Load" Command="{Binding CaptureLoadCommand}" MinWidth="112"/></Grid><Button Content="Cancel capture" Command="{Binding DeviceThermal.CancelThermalCaptureCommand}" HorizontalAlignment="Right" Margin="0,0,0,8"/><TextBlock Text="{Binding DeviceThermal.ThermalCaptureStatus}" Style="{StaticResource Muted}"/><TextBlock Text="Green below 75 C; Yellow 75 to 80 C; Red above 80 C." Style="{StaticResource Muted}"/><TextBlock Text="{Binding DiagnosticContext}" Style="{StaticResource Muted}"/></StackPanel></Border>
</UniformGrid>
<Border Style="{StaticResource BenchmarkCard}" Padding="14" Margin="0,4,0,12"><StackPanel><TextBlock Text="Sustained samples" FontWeight="SemiBold"/><TextBlock Text="Actual interval durations and bytes are retained in details and exports. A drop candidate does not prove SLC exhaustion." Style="{StaticResource Muted}"/><TextBlock Text="No sustained samples yet. Enable sustained testing to collect samples." Foreground="#64748B" Margin="0,10,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SustainedSamples.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ScrollViewer MaxHeight="140" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SustainedSamples}"><ItemsControl.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding sec, StringFormat={}{0} s}" FontFamily="Consolas"/><TextBlock Grid.Column="1" Text="{Binding mbs, StringFormat={}{0:F2} MB/s}" FontFamily="Consolas"/><TextBlock Grid.Column="2" Text="{Binding IntervalSeconds, StringFormat=Interval: {0:F3} s}" Style="{StaticResource Muted}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border>
<Expander Visibility="Collapsed" Header="Technical details and latest result" Margin="0,10"><StackPanel><TextBlock Text="Writes are application data bytes, not physical NAND writes. Results are buffered filesystem QD1, not uncached device speed or durable write latency." TextWrapping="Wrap"/><TextBlock Text="{Binding ResultDetails}" TextWrapping="Wrap"/></StackPanel></Expander>
<Expander Header="Historical benchmarks (saved readings)"><StackPanel><ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedHistoryRow}" MaxHeight="140" AutomationProperties.Name="Benchmark history"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StartedUtc, StringFormat=Historical: {0}}"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding HistoryDetail}" TextWrapping="Wrap"/><TextBlock Text="{Binding Comparison}" TextWrapping="Wrap"/><Button Content="Load more" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Left"/></StackPanel></Expander>
<WrapPanel Margin="0,10"><Button Content="Export Report" Command="{Binding ExportSatisfactionCommand}" Margin="0,0,8,0"/><Button Content="Export History" Command="{Binding ExportHistoryCommand}" Margin="0,0,8,0"/><Button Content="Retry owned-file cleanup" Command="{Binding RetryCleanupCommand}"/><CheckBox Content="Redact serial" IsChecked="{Binding ExportRedactSerial}" Margin="12,0" VerticalAlignment="Center"/><Button Content="Export benchmark TXT" Command="{Binding ExportTextCommand}"/><Button Content="Export benchmark JSON" Command="{Binding ExportJsonCommand}" Margin="8,0,0,0"/></WrapPanel>
</StackPanel></UserControl>
