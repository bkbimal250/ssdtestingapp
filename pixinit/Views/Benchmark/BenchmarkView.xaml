<UserControl x:Class="pixinit.Views.Benchmark.BenchmarkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" SizeChanged="LayoutSizeChanged">
<UserControl.Resources>
<Style x:Key="BenchmarkCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="BorderBrush" Value="#E5E7EB"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="12"/></Style>
<Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="40"/><Setter Property="MinWidth" Value="155"/><Setter Property="Margin" Value="0,0,8,6"/><Style.Triggers><DataTrigger Binding="{Binding BenchmarkMode}" Value="Custom"><Setter Property="ToolTip" Value="Custom settings are in Advanced"/></DataTrigger></Style.Triggers></Style>
<Style x:Key="SizeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,8,6"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#334155"/></Style>
<DataTemplate x:Key="MetricTemplate"><StackPanel><TextBlock Text="{Binding Average}" FontFamily="Consolas" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,6"/><TextBlock Text="{Binding Best}" TextWrapping="Wrap" Foreground="#475569"/><TextBlock Text="{Binding MeasuredAverage}" TextWrapping="Wrap" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding Profile}" Foreground="#64748B" FontSize="11" Margin="0,6,0,0"/></StackPanel></DataTemplate>
</UserControl.Resources>
<StackPanel MaxWidth="1700">
<TextBlock Text="Performance benchmark" Style="{StaticResource Heading}"/>
<TextBlock Text="{Binding ModeLabel}" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
<Border Visibility="{Binding HasBenchmarkResult, Converter={StaticResource BoolVisibility}}" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12"><TextBlock Text="{Binding ResultBadge}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
<Border Style="{StaticResource BenchmarkCard}"><StackPanel>
<WrapPanel IsEnabled="{Binding ConfigurationEditable}"><Button Content="Quick Test" Command="{Binding QuickModeCommand}" ToolTip="3 passes, 5 seconds per profile, up to 15 seconds sustained; total session is longer than 15 seconds"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModeButton}"><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding BenchmarkMode}" Value="Quick"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Deep Test" Command="{Binding DeepModeCommand}" ToolTip="3 passes, 5 seconds per profile, up to 30 seconds sustained"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModeButton}"><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding BenchmarkMode}" Value="Deep"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Custom" Command="{Binding CustomModeCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModeButton}"><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding BenchmarkMode}" Value="Custom"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></WrapPanel>
<TextBlock Text="{Binding WorkloadDescription}" Style="{StaticResource Muted}" Margin="0,2,0,6"/>
<DockPanel IsEnabled="{Binding ConfigurationEditable}"><Button DockPanel.Dock="Right" Content="Browse target..." Command="{Binding BrowseCommand}" Margin="8,0,0,0"/><TextBlock Text="Target folder" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding TargetDirectory}"/></DockPanel>
<TextBlock Text="{Binding TargetSpaceDisplay}" Foreground="{Binding TargetSpaceColor}" Margin="0,8,0,4"/>
<TextBlock Text="{Binding TargetNotice}" Style="{StaticResource Muted}"/>
<TextBlock Visibility="{Binding SmartModeActive, Converter={StaticResource BoolVisibility}}" Text="{Binding SmartModeNotice}" Foreground="{Binding SmartModeColor}" TextWrapping="Wrap" Margin="0,4,0,0"/>
<Expander Header="Advanced" IsExpanded="{Binding AdvancedOpen}" Margin="0,6,0,2"><StackPanel Margin="0,8,0,0" IsEnabled="{Binding ConfigurationEditable}">
<TextBlock Text="File size" FontWeight="SemiBold" Margin="0,0,0,6"/>
<WrapPanel><Button Content="512 MiB" Command="{Binding Size512Command}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SizeButton}"><Style.Triggers><DataTrigger Binding="{Binding FileSizeMiB}" Value="512"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="1024 MiB" Command="{Binding Size1024Command}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SizeButton}"><Style.Triggers><DataTrigger Binding="{Binding FileSizeMiB}" Value="1024"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="2048 MiB" Command="{Binding Size2048Command}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SizeButton}"><Style.Triggers><DataTrigger Binding="{Binding FileSizeMiB}" Value="2048"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></WrapPanel>
<CheckBox Content="Timed profiles (more writes)" IsChecked="{Binding TimedMode}" Margin="0,6"/><WrapPanel Margin="0,6"><TextBlock Text="Test passes" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding TestPasses}" SelectedItem="{Binding Iterations}" Width="65" Margin="8,0,16,0"/><TextBlock Text="Seconds per profile" VerticalAlignment="Center"/><ComboBox IsEnabled="{Binding TimedMode}" ItemsSource="{Binding TimedDurations}" SelectedItem="{Binding DurationSeconds}" Width="65" Margin="8,0"/></WrapPanel>
<TextBlock Text="Sequential and random reads/writes use unbuffered file I/O with write-through." Style="{StaticResource Muted}" Margin="0,6"/>
<WrapPanel Margin="0,4"><CheckBox Content="SEQ1M Q8T1" IsChecked="{Binding SeqQ8}" Margin="0,0,16,6"/><CheckBox Content="SEQ1M Q1T1" IsChecked="{Binding SeqQ1}" Margin="0,0,16,6"/><CheckBox Content="RND4K Q32T16" IsChecked="{Binding RandomQ32}" Margin="0,0,16,6"/><CheckBox Content="RND4K Q1T1" IsChecked="{Binding RandomQ1}" Margin="0,0,0,6"/></WrapPanel>
<CheckBox Content="Include sustained write test" IsChecked="{Binding SustainedWrite}" Margin="0,6"/><TextBlock Text="Deep mode enables 30 seconds; a volume over 80% full is limited to 5 seconds." Style="{StaticResource Muted}"/>
<TextBlock Text="{Binding ConfigurationSummary}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,8"/></StackPanel></Expander>
<TextBlock Text="{Binding WriteLimitSummary}" Style="{StaticResource Muted}" Margin="0,4"/>

<TextBlock Text="{Binding BlockingWarning}" Foreground="#B91C1C" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6" Visibility="{Binding HasBlockingWarning, Converter={StaticResource BoolVisibility}}"/><WrapPanel><Button Content="Start benchmark" Command="{Binding StartCommand}" MinWidth="150" Margin="0,0,8,6"/><Button Content="Cancel benchmark" Command="{Binding CancelCommand}" MinWidth="138" Margin="0,0,12,6"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"/></WrapPanel>
<ProgressBar Value="{Binding OverallProgress, Mode=OneWay}" Maximum="100" Height="10" Margin="0,10,0,6"/>
<TextBlock Text="{Binding RunProgressDisplay}" FontFamily="Consolas" TextWrapping="Wrap"/><TextBlock Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Text="{Binding CurrentOperation}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
</StackPanel></Border>
<Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8" Visibility="{Binding HasSessionProblem, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="{Binding SessionProblem}" TextWrapping="Wrap" Foreground="#991B1B"/><Button Content="Retry owned-file cleanup" Command="{Binding RetryCleanupCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border>
<TextBlock Text="{Binding PerformanceNotice}" Foreground="{Binding PerformanceColor}" TextWrapping="Wrap" Margin="0,10,0,4" ToolTip="{Binding ValidationNotice}"/>
<UniformGrid x:Name="PerformanceCards" Columns="5" Margin="0,8,0,0">
<Border Style="{StaticResource BenchmarkCard}" Margin="0,0,8,8"><StackPanel><TextBlock Text="Sequential read" FontWeight="SemiBold"/><ContentControl Content="{Binding SequentialReadCard}" ContentTemplate="{StaticResource MetricTemplate}" ToolTip="{Binding SequentialReadCard.PassTooltip}"/></StackPanel></Border>
<Border Style="{StaticResource BenchmarkCard}" Margin="0,0,8,8"><StackPanel><TextBlock Text="Sequential write" FontWeight="SemiBold"/><ContentControl Content="{Binding SequentialWriteCard}" ContentTemplate="{StaticResource MetricTemplate}" ToolTip="{Binding SequentialWriteCard.PassTooltip}"/></StackPanel></Border>
<Border Style="{StaticResource BenchmarkCard}" Margin="0,0,8,8"><StackPanel><TextBlock Text="Random read" FontWeight="SemiBold"/><ContentControl Content="{Binding RandomReadCard}" ContentTemplate="{StaticResource MetricTemplate}" ToolTip="{Binding RandomReadCard.PassTooltip}"/></StackPanel></Border>
<Border Style="{StaticResource BenchmarkCard}" Margin="0,0,8,8"><StackPanel><TextBlock Text="Random write" FontWeight="SemiBold"/><ContentControl Content="{Binding RandomWriteCard}" ContentTemplate="{StaticResource MetricTemplate}" ToolTip="{Binding RandomWriteCard.PassTooltip}"/></StackPanel></Border>
<Border Style="{StaticResource BenchmarkCard}" Margin="0,0,8,8"><StackPanel><TextBlock Text="Sustained average" FontWeight="SemiBold"/><TextBlock Text="{Binding SustainedOverallDisplay}" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,6"/><TextBlock Text="{Binding SustainedPostDropDisplay}" TextWrapping="Wrap"/><TextBlock Text="{Binding SustainedResult}" Style="{StaticResource Muted}"/></StackPanel></Border>
</UniformGrid>
<Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8" Visibility="{Binding HasWriteDropWarning, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding WriteDropWarning}" TextWrapping="Wrap" Foreground="#92400E"/></Border>
<Expander Header="All profile results" Margin="0,4,0,12"><ItemsControl ItemsSource="{Binding Summary.ProfileCards}" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource BenchmarkCard}" Width="245" Margin="0,0,8,8" ToolTip="{Binding Tooltip}"><StackPanel><TextBlock Text="{Binding Summary.Profile}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary.Operation}" Foreground="#64748B"/><TextBlock Text="{Binding Summary.AverageMBs, StringFormat={}{0:F2} MB/s Avg}" FontFamily="Consolas" FontSize="21" TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="{Binding Summary.BestMBs, StringFormat=Best {0:F2} MB/s}"/><TextBlock Text="{Binding Summary.AverageIOPS, StringFormat={}{0:F0} IOPS}"/><TextBlock Text="{Binding Summary.CompletedPasses, StringFormat={}{0} completed passes}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
<Button Content="Run Diagnostics Now" Command="{Binding RunDiagnosticsNowCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="{Binding DiagnosticsMissing, Converter={StaticResource BoolVisibility}}"/>
<UniformGrid x:Name="ContextCards" Columns="2">
<Border Style="{StaticResource BenchmarkCard}" Margin="0,0,8,8"><StackPanel><TextBlock Text="TBW / host writes" FontWeight="SemiBold"/><TextBlock Text="{Binding TbwScaleDisplay}" FontFamily="Consolas" FontSize="18" TextWrapping="Wrap" Margin="0,10,0,8"/><ProgressBar Value="{Binding TbwWrittenPercent, Mode=OneWay}" Maximum="100" Height="10" ToolTip="{Binding TbwDisplay}" Margin="0,0,0,8"><ProgressBar.Style><Style TargetType="ProgressBar"><Style.Triggers><DataTrigger Binding="{Binding Tbw.RemainingPercent}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><Border Background="#F0FDF4" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"><TextBlock Text="{Binding TbwRemainingDisplay}" TextWrapping="Wrap" Foreground="#166534"/></Border><TextBlock Text="{Binding TbwRatingNote}" Style="{StaticResource Muted}" Margin="0,8,0,0"/><TextBlock Text="{Binding TbwState}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource BenchmarkCard}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Temperature" FontWeight="SemiBold"/><DockPanel Margin="0,10,0,6"><Ellipse Fill="{Binding TemperatureColor}" Width="12" Height="12" Margin="0,0,10,0"/><TextBlock Text="{Binding TemperatureValue}" FontSize="28" FontFamily="Consolas" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding TemperatureObservation}" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock Text="{Binding DiagnosticContext}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
</UniformGrid>
</StackPanel></UserControl>
