<UserControl x:Class="pixinit.Views.Sata.SataView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="clr-namespace:pixinit.Views.Shared">
  <Grid Margin="18,14,18,8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="12" BorderBrush="{StaticResource SataBrush}" Margin="0,0,0,10"><DockPanel>
      <Button DockPanel.Dock="Right" Content="Read SATA _Diagnostics" Command="{Binding DataContext.ReadSataCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Read SATA diagnostics" ToolTip="Requires a selected confirmed SATA drive and no other storage operation."/>
      <StackPanel><TextBlock Text="{Binding Model}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}"/><TextBlock Text="{Binding Serial, StringFormat=Serial: {0}}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Serial}"/><TextBlock Text="{Binding Connection}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding DataContext.SataOperationStatus, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}"/></StackPanel>
    </DockPanel></Border>
    <TabControl Grid.Row="1" AutomationProperties.Name="SATA sections">
      <TabItem Header="_Overview"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,12,2,4">
        <UniformGrid Columns="3"><shared:MetricCard Label="SMART status" Value="{Binding SmartStatus}"/><shared:MetricCard Label="Temperature" Value="{Binding Temperature}"/><shared:MetricCard Label="Verified wear" Value="{Binding Wear}"/></UniformGrid>
        <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ObservedLocal, StringFormat=Observed locally: {0}}" Style="{StaticResource Muted}"/><TextBlock Text="Assessment" Style="{StaticResource Heading}"/></DockPanel><TextBlock Text="{Binding Assessment}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Coverage}" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SMART-reported status" Style="{StaticResource Heading}"/><TextBlock Text="{Binding SmartExplanation}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Discrepancies}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="S_MART"><Grid Margin="2,12,2,4" MinHeight="150"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DataGrid MinHeight="120" ItemsSource="{Binding Attributes}" SelectedItem="{Binding SelectedAttribute}" AutomationProperties.Name="SATA SMART attributes" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id, StringFormat=X2}" Width="45"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="130"/><DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="70"/><DataGridTextColumn Header="Worst" Binding="{Binding Worst}" Width="65"/><DataGridTextColumn Header="Threshold" Binding="{Binding Threshold}" Width="85"/><DataGridTextColumn Header="Raw value" Binding="{Binding RawValue}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid>
        <Border Background="#F7F9FC" Visibility="{Binding HasNoAttributes, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False"><TextBlock Text="No validated SMART attributes available" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12" FontSize="16" FontWeight="SemiBold"/></Border>
        <TextBlock Grid.Row="1" Text="{Binding DataStatus}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
      </Grid></TabItem>
      <TabItem Header="_Details"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,12,2,4">
        <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Selected SMART attribute" Style="{StaticResource Heading}"/><TextBlock Text="{Binding AttributeDetail}" Style="{StaticResource Muted}"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Endurance" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Endurance}" Style="{StaticResource Muted}"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Discovery and ATA identity" Style="{StaticResource Heading}"/><TextBlock Text="{Binding DiscoveryDetails}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Ata}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Interface information" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Interface}" Style="{StaticResource Muted}"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><Expander Header="Technical assessment details"><TextBlock Text="{Binding AssessmentDetails}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></Expander></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="_Raw Data"><Grid Margin="2,12,2,4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Raw ATA responses · may contain the full device serial" Style="{StaticResource Muted}" Margin="0,0,0,8"/><TextBox Grid.Row="1" Text="{Binding CommandDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Raw ATA responses"/></Grid></TabItem>
    </TabControl>
  </Grid>
</UserControl>
