<UserControl x:Class="pixinit.Views.Sata.SataView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="clr-namespace:pixinit.Views.Shared">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/pixinit;component/Resources/Styles/Diagnostics.xaml"/></ResourceDictionary.MergedDictionaries><Style x:Key="DetailsCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E5E7EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
<Style x:Key="DetailsHeader" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
<Style x:Key="DetailsValue" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,4"/></Style>
<Style x:Key="DetailsExpander" TargetType="Expander"><Setter Property="IsExpanded" Value="True"/><Setter Property="Margin" Value="0,4,0,4"/></Style>
<DataTemplate x:Key="DetailRow"><Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8" Margin="0,0,8,8"><StackPanel><TextBlock Text="{Binding Label}" FontFamily="Segoe UI" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock Text="{Binding Value}" Style="{StaticResource DetailsValue}"/></StackPanel></Border></DataTemplate>
<DataTemplate x:Key="RequestRow"><Border Background="#F9FAFB" CornerRadius="6" Padding="8" Margin="0,0,8,8"><StackPanel><TextBlock Text="{Binding Label}" FontSize="12"/><DockPanel><Ellipse Width="7" Height="7" Fill="{Binding Color}" Margin="0,0,6,0"/><TextBlock Text="{Binding Value}" Style="{StaticResource DetailsValue}"/></DockPanel></StackPanel></Border></DataTemplate></ResourceDictionary></UserControl.Resources>
  <Grid Margin="12,10,12,6">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource DiagnosticCard}" Padding="12" BorderBrush="{StaticResource SataBrush}" Margin="0,0,0,10"><DockPanel>
      <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Read SATA _Diagnostics" Command="{Binding DataContext.ReadSataCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Read SATA diagnostics" ToolTip="Requires a selected confirmed SATA drive and no other storage operation."/>
      <StackPanel><TextBlock Text="{Binding Model}" TextWrapping="NoWrap" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}"/><TextBlock Text="{Binding Serial, StringFormat=Serial: {0}}" Style="{StaticResource Muted}" TextWrapping="Wrap"/><WrapPanel Margin="0,8,0,6">
 <Border Background="#EDF2FF" CornerRadius="6" Padding="10,6" Margin="0,0,8,4"><StackPanel><TextBlock Text="PROTOCOL" FontSize="10" Foreground="#52617B"/><TextBlock Text="{Binding ProtocolDisplay}" FontWeight="SemiBold" Foreground="#294E96"/></StackPanel></Border>
 <Border Background="#F1F4F8" CornerRadius="6" Padding="10,6" Margin="0,0,8,4" ToolTip="{Binding MediaEvidence}"><StackPanel><TextBlock Text="MEDIA TYPE" FontSize="10" Foreground="#52617B"/><TextBlock Text="{Binding MediaDisplay}" FontWeight="SemiBold"/></StackPanel></Border>
 <Border Background="#F1F4F8" CornerRadius="6" Padding="10,6" Margin="0,0,8,4"><StackPanel><TextBlock Text="METADATA ACCESS" FontSize="10" Foreground="#52617B"/><TextBlock Text="{Binding AccessDisplay}" FontWeight="SemiBold"/></StackPanel></Border>
 </WrapPanel><Expander Header="Media identification evidence" Margin="0,0,0,6"><TextBlock Text="{Binding MediaEvidence}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,6"/></Expander><TextBlock Text="{Binding DataContext.SataOperationStatus, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}"/></StackPanel>
    </DockPanel></Border>
    <TabControl Background="#F7F9FC" BorderThickness="0" Grid.Row="1" AutomationProperties.Name="SATA sections">
      <TabItem Header="_Overview"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8,12,8,4"><shared:FirstPageView DiagnosticCommand="{Binding DataContext.ReadSataCommand, RelativeSource={RelativeSource AncestorType=Window}}"/><Expander Header="Additional diagnostic overview"><Grid Height="420"><shared:WebOverview Busy="{Binding DataContext.SataBusy, RelativeSource={RelativeSource AncestorType=Window}}" Status="{Binding DataContext.SataOperationStatus, RelativeSource={RelativeSource AncestorType=Window}}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,12,8,4">
        <UniformGrid Columns="3"><shared:MetricCard Label="SMART status" Value="{Binding SmartStatus}"/><shared:MetricCard Label="Temperature" Value="{Binding Temperature}"/><shared:MetricCard Label="Verified wear" Value="{Binding Wear}"/></UniformGrid>
        <Border Style="{StaticResource AssessmentCard}" Margin="0,0,0,10"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ObservedLocal, StringFormat=Observed locally: {0}}" Style="{StaticResource Muted}"/><TextBlock Text="Assessment" Style="{StaticResource Heading}"/></DockPanel><TextBlock Text="{Binding Assessment}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Coverage}" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource DiagnosticCard}"><StackPanel><TextBlock Text="SMART-reported status" Style="{StaticResource Heading}"/><TextBlock Text="{Binding SmartExplanation}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Discrepancies}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
      </StackPanel></ScrollViewer></shared:WebOverview></Grid></Expander></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="S_MART"><Grid Margin="8,12,8,4" MinHeight="150"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DataGrid MinHeight="120" HeadersVisibility="Column" BorderBrush="#E5E7EB" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding Attributes}" SelectedItem="{Binding SelectedAttribute}" AutomationProperties.Name="SATA SMART attributes" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id, StringFormat=X2}" Width="45"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="130"/><DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="70"/><DataGridTextColumn Header="Worst" Binding="{Binding Worst}" Width="65"/><DataGridTextColumn Header="Threshold" Binding="{Binding Threshold}" Width="85"/><DataGridTextColumn Header="Raw value" Binding="{Binding RawValue}" Width="120"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid>
        <Border Background="#F7F9FC" Visibility="{Binding HasNoAttributes, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False"><TextBlock Text="No validated SMART attributes available" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,38,12,12" FontSize="14" FontWeight="SemiBold"/></Border>
        <TextBlock Grid.Row="1" Text="{Binding DataStatus}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
      </Grid></TabItem>
      <TabItem Header="_Details"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,12,8,4"><Border Style="{StaticResource DetailsCard}"><StackPanel><TextBlock Text="ATA identity and telemetry" Style="{StaticResource DetailsHeader}"/><ItemsControl ItemsSource="{Binding EntireSsdInfo}" ItemTemplate="{StaticResource DetailRow}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><TextBlock Text="{Binding Discrepancies}" Style="{StaticResource DetailsValue}"/></StackPanel></Border>
        <Border Style="{StaticResource DetailsCard}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Selected SMART attribute" Style="{StaticResource DetailsHeader}"/><TextBlock Text="{Binding AttributeDetail}" Style="{StaticResource DetailsValue}"/></StackPanel></Border>
        <Border Style="{StaticResource DetailsCard}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Endurance" Style="{StaticResource DetailsHeader}"/><Expander Style="{StaticResource DetailsExpander}" Header="View Endurance information"><TextBlock Text="{Binding Endurance}" Style="{StaticResource DetailsValue}" Margin="0,8,0,0"/></Expander></StackPanel></Border>
        <Border Style="{StaticResource DetailsCard}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Discovery and ATA identity" Style="{StaticResource DetailsHeader}"/><Expander Style="{StaticResource DetailsExpander}" Header="View Windows discovery"><TextBlock Text="{Binding DiscoveryDetails}" Style="{StaticResource DetailsValue}" Margin="0,8,0,0"/></Expander><TextBlock Text="{Binding Ata}" Style="{StaticResource DetailsValue}" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource DetailsCard}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Interface information" Style="{StaticResource DetailsHeader}"/><Expander Style="{StaticResource DetailsExpander}" Header="View Interface information"><TextBlock Text="{Binding Interface}" Style="{StaticResource DetailsValue}" Margin="0,8,0,0"/></Expander></StackPanel></Border>
        <Border Style="{StaticResource DetailsCard}"><Expander Style="{StaticResource DetailsExpander}" Header="Technical assessment details"><TextBlock Text="{Binding AssessmentDetails}" Style="{StaticResource DetailsValue}" Margin="0,8,0,0"/></Expander></Border>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
  </Grid>
</UserControl>
