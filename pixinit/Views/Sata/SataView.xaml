<UserControl x:Class="pixinit.Views.Sata.SataView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="clr-namespace:pixinit.Views.Shared" SizeChanged="OnSizeChanged">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="18,14,18,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="12" BorderBrush="{StaticResource SataBrush}">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Read SATA _Diagnostics" Command="{Binding DataContext.ReadSataCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Read SATA diagnostics" ToolTipService.ShowOnDisabled="True" ToolTip="Requires a selected confirmed SATA drive and no other storage operation. Does not query NVMe or enable SMART." />
            <TextBlock Text="{Binding DataContext.SataOperationStatus, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
          </DockPanel>
          <TextBlock Text="{Binding Model}" FontSize="21" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}" />
          <TextBlock Text="{Binding Serial, StringFormat=Serial: {0}}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Serial}" />
          <TextBlock Text="{Binding Connection}" Style="{StaticResource Muted}" />
        </StackPanel>
      </Border>
      <UniformGrid Grid.Row="1" Columns="3">
        <shared:MetricCard Label="SMART status" Value="{Binding SmartStatus}" />
        <shared:MetricCard Label="Temperature" Value="{Binding Temperature}" />
        <shared:MetricCard Label="Verified wear" Value="{Binding Wear}" />
      </UniformGrid>
      <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="10">
        <StackPanel><TextBlock Text="Application assessment / diagnostic checklist" Style="{StaticResource Heading}" /><TextBlock Text="{Binding Assessment}" FontWeight="SemiBold" TextWrapping="Wrap" /><Expander Header="Evidence, checks and missing inputs"><TextBlock Text="{Binding AssessmentDetails}" Style="{StaticResource Muted}" Margin="0,8,0,0" /></Expander></StackPanel>
      </Border>
      <Grid Grid.Row="3" x:Name="DetailsGrid" Height="360">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="DetailColumn" Width="310" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition x:Name="DetailRow" Height="0" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="SMART attributes" Style="{StaticResource Heading}" />
            <DataGrid Grid.Row="1" ItemsSource="{Binding Attributes}" SelectedItem="{Binding SelectedAttribute}" AutomationProperties.Name="SATA SMART attributes">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id, StringFormat=X2}" Width="45" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="130" />
                <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="70" />
                <DataGridTextColumn Header="Worst" Binding="{Binding Worst}" Width="65" />
                <DataGridTextColumn Header="Threshold" Binding="{Binding Threshold}" Width="85" />
                <DataGridTextColumn Header="Raw value" Binding="{Binding RawValue}" Width="100" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
              </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="1" Background="#F7F9FC" Margin="0,40,0,0" Visibility="{Binding HasNoAttributes, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
              <TextBlock Text="No validated SMART attributes available" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12" FontSize="16" FontWeight="SemiBold" />
            </Border>
            <TextBlock Grid.Row="2" Text="{Binding DataStatus}" Style="{StaticResource Muted}" Margin="0,10,0,0" ToolTip="No SMART readings are shown until a real SATA provider result is available." />
          </Grid>
        </Border>
        <ScrollViewer x:Name="DetailPanel" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel><TextBlock Text="SMART-reported status" Style="{StaticResource Heading}" /><TextBlock Text="{Binding SmartExplanation}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Discrepancies}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Attribute detail" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding AttributeDetail}" Style="{StaticResource Muted}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Endurance" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding Endurance}" Style="{StaticResource Muted}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Discovery / ATA details" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding DiscoveryDetails}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                <TextBlock Text="{Binding Ata}" Style="{StaticResource Muted}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Interface information" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding Interface}" Style="{StaticResource Muted}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><Expander Header="Technician: command outcomes / raw bytes" AutomationProperties.Name="SATA raw command responses"><StackPanel><TextBlock Text="Raw identity payload may contain the full serial. Do not include it in shared screenshots." Style="{StaticResource Muted}" Margin="0,8"/><TextBox Text="{Binding CommandDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" MaxHeight="300" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Raw ATA responses" /></StackPanel></Expander></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
