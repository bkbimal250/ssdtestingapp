<Window x:Class="pixinit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:shared="clr-namespace:pixinit.Views.Shared" xmlns:benchmark="clr-namespace:pixinit.Views.Benchmark" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sata="clr-namespace:pixinit.Views.Sata" xmlns:nvme="clr-namespace:pixinit.Views.Nvme" Style="{StaticResource {x:Type Window}}" Title="PIXINIT · Storage diagnostics" Width="1240" Height="820" MinWidth="760" MinHeight="640" WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource CanvasBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="10,5" Margin="0,0,12,0">
            <TextBlock Text="P" Foreground="White" FontSize="22" FontWeight="Bold" />
          </Border>
          <StackPanel>
            <TextBlock Text="PIXINIT" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Storage diagnostics workspace" Style="{StaticResource Muted}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="_Cancel" Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel discovery" Margin="0,0,8,0" />
          <Button Content="Scan _Drives" Command="{Binding ScanCommand}" ToolTip="{Binding ScanExplanation}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Scan drives" AutomationProperties.HelpText="{Binding ScanExplanation}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#EAF0FA" Padding="22,9">
      <TextBlock Text="{Binding ScanExplanation}" Foreground="#354E74" />
    </Border>
    <TabControl x:Name="WorkspaceTabs" SelectedIndex="{Binding WorkspaceIndex}" Grid.Row="2" Grid.RowSpan="2" Margin="16,12,16,10" AutomationProperties.Name="Workspace sections">
      <TabItem Header="_Diagnostics"><Grid>
    <TabControl x:Name="ProtocolTabs" SelectedIndex="{Binding ActiveTab}" Margin="16,14,16,10" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}" AutomationProperties.Name="Storage protocol">
      <TabItem Header="_SATA" AutomationProperties.Name="SATA">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="SATA devices" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Grid.Row="1" Text="No SATA devices discovered" TextWrapping="Wrap" Style="{StaticResource Muted}" Visibility="{Binding SataEmpty, Converter={StaticResource BoolVisibility}}"/><ListBox Grid.Row="2" ItemsSource="{Binding SataDevices}" SelectedItem="{Binding SelectedSata}" AutomationProperties.Name="Selected SATA drive" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" Margin="0,6"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
          <sata:SataView Grid.Column="1" DataContext="{Binding Sata}"/>
        </Grid>
      </TabItem>
      <TabItem Header="_NVMe" AutomationProperties.Name="NVMe">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="NVMe devices" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Grid.Row="1" Text="No NVMe devices discovered" TextWrapping="Wrap" Style="{StaticResource Muted}" Visibility="{Binding NvmeEmpty, Converter={StaticResource BoolVisibility}}"/><ListBox Grid.Row="2" ItemsSource="{Binding NvmeDevices}" SelectedItem="{Binding SelectedNvme}" AutomationProperties.Name="Selected NVMe drive" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" Margin="0,6"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
          <nvme:NvmeView Grid.Column="1" DataContext="{Binding Nvme}"/>
        </Grid>
      </TabItem>
    </TabControl></Grid>
      </TabItem>
    <TabItem x:Name="BenchmarkTab" Header="_Benchmark" AutomationProperties.Name="Benchmark"><Grid><Popup IsOpen="{Binding HistoryVisible}" Placement="Center" StaysOpen="False" AllowsTransparency="False"><Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" Width="720" MaxHeight="560"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Close history" Command="{Binding CloseHistoryCommand}"/><TextBlock Text="Historical diagnostic snapshots and exports" FontWeight="SemiBold"/></DockPanel><Grid Margin="16" VerticalAlignment="Top" MaxHeight="440">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel Grid.ColumnSpan="2" Margin="0,0,0,8">
          <TextBlock Text="Retention days:" VerticalAlignment="Center"/><TextBox Text="{Binding History.RetentionDays}" Width="48" Margin="8,0" AutomationProperties.Name="History retention days"/>
          <Button Content="Apply" Command="{Binding History.ApplyRetentionCommand}" Margin="0,0,12,0"/>
          <TextBlock Text="Protocol:" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding History.ProtocolFilters}" SelectedItem="{Binding History.ProtocolFilter}" Width="76" Margin="8,0"/>
          <Button Content="Filter" Command="{Binding History.ApplyFiltersCommand}" Margin="0,0,6,0"/><Button Content="This device" Command="{Binding History.FilterSelectedDeviceCommand}" Margin="0,0,6,0"/><Button Content="Clear" Command="{Binding History.ClearFiltersCommand}" Margin="0,0,8,0"/><Button Content="Load more" Command="{Binding History.LoadMoreCommand}"/>
          <TextBlock Text="{Binding History.Status}" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </WrapPanel>
        <ListBox MinHeight="180" MaxHeight="280" Padding="8" BorderBrush="{StaticResource LineBrush}" Grid.Row="1" ItemsSource="{Binding History.Sessions}" SelectedItem="{Binding History.Selected}" AutomationProperties.Name="Historical sessions">
          <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="10"><StackPanel><TextBlock Text="{Binding ObservedAtUtc}"/><TextBlock Text="{Binding Model}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Protocol}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding CompletionState, StringFormat=Session: {0}}" Style="{StaticResource Muted}"/><TextBlock><Run Text="{Binding Assessment}"/><Run Text=" · coverage "/><Run Text="{Binding Coverage}"/></TextBlock></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" Padding="12"><StackPanel><TextBlock Text="Historical snapshot" Style="{StaticResource Heading}"/><TextBlock Text="Select a saved session to view its original readings and observation time." Style="{StaticResource Muted}" Margin="0,0,0,8"/><ScrollViewer MaxHeight="230" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding History.Detail}" TextWrapping="Wrap"/><Expander Header="Compatible snapshot comparison"><TextBlock Text="{Binding History.Comparison}" TextWrapping="Wrap" Margin="0,8,0,0"/></Expander></StackPanel></ScrollViewer></StackPanel></Border>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><CheckBox Content="Redact serial" IsChecked="{Binding History.ExportRedactSerial}" VerticalAlignment="Center" Margin="0,0,12,0"/><CheckBox Content="Include raw payloads" IsChecked="{Binding History.ExportIncludeRawPayloads}" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Raw payloads can contain device identity data."/><Button Content="Export TXT" Command="{Binding History.ExportTextCommand}"/><Button Content="Export JSON" Command="{Binding History.ExportJsonCommand}" Margin="8,0,0,0"/></StackPanel>
      </Grid>
    </StackPanel></Border></Popup><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><benchmark:BenchmarkView Margin="16" DataContext="{Binding Benchmark}"/></ScrollViewer></Grid></TabItem>
<TabItem x:Name="OtherDevicesTab" Header="_Other / Unidentified" AutomationProperties.Name="Other / Unidentified"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Margin="16" VerticalAlignment="Top" Padding="12"><Expander x:Name="UnidentifiedDevicesSection" Header="{Binding OtherSummary}" IsExpanded="True" AutomationProperties.Name="Unidentified devices"><Expander.Style><Style TargetType="Expander"><Setter Property="Foreground" Value="#25364D"/><Style.Triggers><DataTrigger Binding="{Binding OtherDevices.Count}" Value="0"><Setter Property="Foreground" Value="#64748B"/></DataTrigger></Style.Triggers></Style></Expander.Style><ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,8,0,0"><TextBlock Text="Devices whose SATA or NVMe protocol could not be established appear here." Style="{StaticResource Muted}"/>
        <TextBlock Text="Underlying protocol is not established for these disks. USB, RAID, ATA and virtual buses do not establish SATA or NVMe." Style="{StaticResource Muted}" />
        <ListBox ItemsSource="{Binding OtherDevices}" SelectedItem="{Binding SelectedOther}" MaxHeight="520" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Unidentified devices">
<ListBox.Style><Style TargetType="ListBox"><Style.Triggers><DataTrigger Binding="{Binding OtherDevices.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Padding="12"><StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DiscoverySummary}" Style="{StaticResource Muted}" />
                <Expander Header="Reported device details" AutomationProperties.Name="Unidentified disk details">
                  <StackPanel Margin="10,6,0,6">
                    <TextBlock Text="{Binding Firmware, StringFormat=Firmware: {0}, TargetNullValue=Unavailable}" />
                    <TextBlock Text="{Binding CapacityBytes, StringFormat=Physical-disk capacity in bytes: {0}, TargetNullValue=Unavailable}" />
                    <TextBlock Text="{Binding Source, StringFormat=Source: {0}}" />
                    <TextBlock Text="{Binding IdentityEvidence, StringFormat=Identity evidence: {0}}" />
                    <TextBlock Text="{Binding InterfacePath, StringFormat=Interface: {0}, TargetNullValue=Unavailable}" />
                    <ItemsControl ItemsSource="{Binding MountPoints}" AutomationProperties.Name="Mapped mount points" />
                  </StackPanel>
                </Expander>
              </StackPanel></Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </ScrollViewer></Expander></Border></ScrollViewer></TabItem>


    </TabControl>
    <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding OperationStatus}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding Freshness}" Style="{StaticResource Muted}" FontSize="11" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding DeviceSummary}" Style="{StaticResource Muted}" Margin="14,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>
