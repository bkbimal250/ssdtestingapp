<Window x:Class="pixinit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:pixinit.ViewModels.Shell" xmlns:benchmark="clr-namespace:pixinit.Views.Benchmark" Title="PIXINIT" Width="1060" Height="700" MinWidth="1060" MaxWidth="1060" MinHeight="700" MaxHeight="700" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowState="Normal" Background="#FFF8F0" Foreground="#000000" FontFamily="Segoe UI" FontSize="11" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality">
  <Window.Resources>
    <shell:DiskPickerTextConverter x:Key="DiskPickerText"/>
    <shell:DashboardScaleConverter x:Key="DashboardScale"/><shell:DashboardSingleLineConverter x:Key="SingleLine"/><shell:QcReasonConverter x:Key="QcReason"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#000000"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
    <Style x:Key="DashboardButton" TargetType="Button"><Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Background" Value="#FFB800"/><Setter Property="Foreground" Value="#000000"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="#000000" BorderThickness="1" Padding="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <DataTemplate x:Key="PhysicalDiskOptionTemplate"><TextBlock VerticalAlignment="Center" Foreground="#000000" FontSize="12" LineHeight="16" Padding="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><TextBlock.Text><MultiBinding Converter="{StaticResource DiskPickerText}" ConverterParameter="Short"><Binding/><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ComboBox}"/><Binding Path="DataContext.PickerRevision" RelativeSource="{RelativeSource AncestorType=ComboBox}"/></MultiBinding></TextBlock.Text><TextBlock.ToolTip><StackPanel><TextBlock Text="{Binding Model}" FontWeight="Bold"/><TextBlock Text="{Binding Serial, StringFormat=Serial: {0}}"/><TextBlock Text="{Binding CapacityDisplay, StringFormat=Size: {0}}"/></StackPanel></TextBlock.ToolTip></TextBlock></DataTemplate>
    <Style x:Key="PhysicalDiskOption" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#000000"/><Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="32"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="10,0"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="OptionSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="#000000" BorderThickness="0,0,0,1"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="OptionSurface" Property="Background" Value="#FFF3CC"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="OptionSurface" Property="Background" Value="#FFB800"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PhysicalDiskPicker" TargetType="ComboBox">
      <Setter Property="Foreground" Value="#000000"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,4,10,4"/><Setter Property="MaxDropDownHeight" Value="180"/><Setter Property="StaysOpenOnEdit" Value="False"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="ItemTemplate" Value="{StaticResource PhysicalDiskOptionTemplate}"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource PhysicalDiskOption}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="PickerSurface" Background="#FFFFFF" BorderBrush="#FFB800" BorderThickness="1" CornerRadius="6">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" BorderThickness="0"><Path Data="M 3,5 L 8,10 L 13,5" Stroke="#000000" StrokeThickness="1.7" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Border></ControlTemplate></ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="10,0,36,0" VerticalAlignment="Center" Content="{TemplateBinding SelectedItem}" ContentTemplate="{TemplateBinding ItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
            </Grid>
          </Border>
          <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None" Width="{TemplateBinding ActualWidth}">
            <Border Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,0,0" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter x:Name="ItemsPresenter"/></ScrollViewer></Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PickerSurface" Property="BorderBrush" Value="#FFB800"/><Setter TargetName="PickerSurface" Property="BorderThickness" Value="1.5"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PickerSurface" Property="Background" Value="#FFFFFF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

  </Window.Resources>
  <Grid x:Name="DashboardViewport" Background="#FFF8F0" ClipToBounds="True">
    <Grid x:Name="DashboardLayout" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
      <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
      <Border Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1"><Grid Margin="8,0"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="44"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/pixinit-logo.png" Height="28" Width="142" HorizontalAlignment="Left" AutomationProperties.Name="PIXINIT"/><TextBlock Text="|" Foreground="#000000" FontSize="18" Margin="10,0" VerticalAlignment="Center"/><TextBlock Text="SSD Diagnostics" Foreground="#000000" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
        <Button Grid.Column="1" Width="92" Height="32" Content="Cancel" Command="{Binding CancelCommand}" Background="#FFFFFF" Foreground="#000000" HorizontalAlignment="Right"/>
        <Button Grid.Column="2" Width="92" Height="32" Content="Scan drives" Command="{Binding ScanCommand}" Style="{StaticResource DashboardButton}" HorizontalAlignment="Right"/>
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Height="32" Margin="0,6" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Physical disk" Width="92" Margin="0,0,8,0" FontSize="12" Foreground="#666666" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="None" VerticalAlignment="Center"/><ComboBox x:Name="DiskPicker" Grid.Column="1" Height="32" MinWidth="0" MaxWidth="836" HorizontalAlignment="Stretch" VerticalAlignment="Center" ItemsSource="{Binding AllDevices}" SelectedItem="{Binding SelectedDisk, Mode=TwoWay}" Style="{StaticResource PhysicalDiskPicker}" DropDownOpened="PhysicalDiskPicker_Opened" AutomationProperties.Name="Select physical disk"/><Border Grid.Column="2" Height="22" Background="#FFB800" CornerRadius="11" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding SelectedDisk.Protocol}" Foreground="#000000" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/></Border></Grid>
      </Grid></Border>
      <Grid Grid.Row="1">
        <TabControl x:Name="RightTabs" Margin="8,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#FFF8F0" BorderBrush="#E5E5E5" Foreground="#000000" SelectedIndex="0">
          <TabItem Header="Benchmark" Foreground="#000000">
            <ScrollViewer x:Name="BenchmarkScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Background="#FFF8F0">
              <benchmark:BenchmarkView x:Name="EmbeddedBenchmark" DataContext="{Binding Benchmark}" VerticalAlignment="Top" HorizontalAlignment="Stretch" SnapsToDevicePixels="True"/>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Diagnostics" Foreground="#000000">
            <TabItem.Resources>
              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="ToolTip" Value="{x:Null}"/>
              </Style>
              <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Background" Value="#F0F0F0"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                  <Grid Width="8" Background="#F0F0F0">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                      <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="#F0F0F0" BorderThickness="0"/></Track.DecreaseRepeatButton>
                      <Track.Thumb><Thumb Background="#FFB800" Width="8"/></Track.Thumb>
                      <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="#F0F0F0" BorderThickness="0"/></Track.IncreaseRepeatButton>
                    </Track>
                  </Grid>
                </ControlTemplate></Setter.Value></Setter>
              </Style>
            </TabItem.Resources>
            <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,8,8" Margin="0">
              <StackPanel Margin="0,0,0,16">
                <Border Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="12">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding SelectedDisk.DisplayName, TargetNullValue=Select a drive}" FontSize="15" FontWeight="Bold" Foreground="#000000" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <Button Grid.Column="1" Height="32" FontWeight="Bold" Foreground="#000000" Command="{Binding DashboardRefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource DashboardButton}">
                            <Setter Property="Content" Value="Read SATA diagnostics"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#000000"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ShowNvmeDiagnostics}" Value="True"><Setter Property="Content" Value="Read NVMe diagnostics"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Border MinHeight="22" Padding="8,4" Background="#F5F5F5" CornerRadius="11" Margin="0,0,8,0">
                        <TextBlock FontSize="11" Foreground="#000000" TextWrapping="Wrap" TextTrimming="None">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                              <Setter Property="Text" Value="{Binding Sata.LinkDisplay}"/>
                              <Style.Triggers><DataTrigger Binding="{Binding ShowNvmeDiagnostics}" Value="True"><Setter Property="Text" Value="{Binding Nvme.LinkDisplay}"/></DataTrigger></Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                      <Border MinHeight="22" Padding="8,4" Background="#F5F5F5" CornerRadius="11">
                        <TextBlock FontSize="11" Foreground="#000000" TextWrapping="Wrap" TextTrimming="None">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                              <Setter Property="Text" Value="{Binding SataOperationStatus}"/>
                              <Style.Triggers><DataTrigger Binding="{Binding ShowNvmeDiagnostics}" Value="True"><Setter Property="Text" Value="{Binding NvmeOperationStatus}"/></DataTrigger></Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <ContentControl Margin="0,8,0,0">
                  <ContentControl.Style>
                    <Style TargetType="ContentControl">
                      <Setter Property="Content" Value="{Binding Sata}"/>
                      <Style.Triggers><DataTrigger Binding="{Binding ShowNvmeDiagnostics}" Value="True"><Setter Property="Content" Value="{Binding Nvme}"/></DataTrigger></Style.Triggers>
                    </Style>
                  </ContentControl.Style>
                  <ContentControl.ContentTemplate>
                    <DataTemplate>
                      <Border Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/><RowDefinition Height="8"/><RowDefinition Height="72"/></Grid.RowDefinitions>
                          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="Storage usage" FontSize="13" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Volume" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Grid.Column="2" Width="70" Height="26" ItemsSource="{Binding VolumeChoices}" SelectedItem="{Binding SelectedVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                          <TextBlock Grid.Row="1" Text="Shows the selected volume, not the physical disk's capacity. Free is the space available to this user; quotas can affect it. Spanned volumes are not attributed to a single disk." FontSize="11" Foreground="#666666" TextWrapping="Wrap" TextTrimming="None"/>
                          <Grid Grid.Row="2" Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="16"/><RowDefinition Height="8"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding UsedPercentDisplay, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#000000"/><TextBlock Grid.Column="1" Text="{Binding FreeStorageDisplay, Mode=OneWay, StringFormat={}{0} free}" FontSize="12" Foreground="#666666" HorizontalAlignment="Right"/><ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding UsedPercent, Mode=OneWay, TargetNullValue=0}" Maximum="100" Height="8" Background="#F0F0F0" Foreground="#FFB800"/></Grid>
                          <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="#F8F8F8" CornerRadius="6" Padding="10"><StackPanel><TextBlock Text="TOTAL" FontSize="11" Foreground="#666666"/><TextBlock Text="{Binding TotalStorageDisplay}" FontSize="18" FontWeight="Bold" Foreground="#000000"/><TextBlock Text="Selected volume capacity" FontSize="11" Foreground="#666666"/></StackPanel></Border>
                            <Border Grid.Column="2" Background="#F8F8F8" CornerRadius="6" Padding="10"><StackPanel><TextBlock Text="USED" FontSize="11" Foreground="#666666"/><TextBlock Text="{Binding UsedStorageDisplay}" FontSize="18" FontWeight="Bold" Foreground="#000000"/><TextBlock Text="Selected volume usage" FontSize="11" Foreground="#666666"/></StackPanel></Border>
                            <Border Grid.Column="4" Background="#F8F8F8" CornerRadius="6" Padding="10"><StackPanel><TextBlock Text="FREE (AVAILABLE)" FontSize="11" Foreground="#666666"/><TextBlock Text="{Binding FreeStorageDisplay}" FontSize="18" FontWeight="Bold" Foreground="#000000"/><TextBlock Text="Available to this user" FontSize="11" Foreground="#666666"/></StackPanel></Border>
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
                <Border Margin="0,8,0,0" BorderBrush="#FFB800" BorderThickness="1" Padding="12" CornerRadius="8" Background="#FFFFFF">
                  <TextBlock FontSize="11" Foreground="#000000" TextWrapping="Wrap" TextTrimming="None">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Text" Value="{Binding Sata.FirstPageWarnings}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding ShowNvmeDiagnostics}" Value="True"><Setter Property="Text" Value="{Binding Nvme.FirstPageWarnings}"/></DataTrigger></Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                      <TextBlock Text="Drive identity" FontSize="13" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,8"/>
                      <ItemsControl x:Name="IdentityFields" ItemsSource="{Binding DashboardIdentity}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" MinHeight="28" Padding="0,4">
                              <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#666666" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" Foreground="#000000" TextWrapping="Wrap" TextTrimming="None" MaxWidth="220" HorizontalAlignment="Right" VerticalAlignment="Center">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                      <Setter Property="FontWeight" Value="Normal"/>
                                      <Style.Triggers><DataTrigger Binding="{Binding Label}" Value="Model"><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="2" Content="Copy" Height="20" Width="40" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Click="CopyField" Tag="{Binding Value}">
                                  <Button.Style>
                                    <Style TargetType="Button">
                                      <Setter Property="Visibility" Value="Collapsed"/>
                                      <Setter Property="Height" Value="20"/>
                                      <Setter Property="Width" Value="40"/>
                                      <Setter Property="FontSize" Value="10"/>
                                      <Setter Property="Padding" Value="0"/>
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding Label}" Value="Firmware"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Label}" Value="Serial"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Button.Style>
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="2">
                    <Border Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="12">
                      <StackPanel>
                        <TextBlock Text="Health" FontSize="13" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="HealthFields" ItemsSource="{Binding DashboardHealth}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" MinHeight="28" Padding="0,4">
                                <Grid VerticalAlignment="Center">
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                  <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#666666" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,8,0"/>
                                  <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" Foreground="#000000" TextWrapping="Wrap" TextTrimming="None" MaxWidth="160" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <Border Margin="0,8,0,0" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="12">
                      <StackPanel>
                        <TextBlock Text="Usage" FontSize="13" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,8"/>
                        <StackPanel>
                          <StackPanel.Style>
                            <Style TargetType="StackPanel">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers><DataTrigger Binding="{Binding ShowNvmeDiagnostics}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                          </StackPanel.Style>
                          <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" MinHeight="28" Padding="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Used" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Nvme.UsedPercentDisplay}" FontSize="12" Foreground="#000000" TextWrapping="Wrap" TextTrimming="None" MaxWidth="160" HorizontalAlignment="Right"/></Grid></Border>
                          <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" MinHeight="28" Padding="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Total" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Nvme.TotalStorageDisplay}" FontSize="12" Foreground="#000000" TextWrapping="Wrap" TextTrimming="None" MaxWidth="160" HorizontalAlignment="Right"/></Grid></Border>
                          <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" MinHeight="28" Padding="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Free" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Nvme.FreeStorageDisplay}" FontSize="12" Foreground="#000000" TextWrapping="Wrap" TextTrimming="None" MaxWidth="160" HorizontalAlignment="Right"/></Grid></Border>
                          <TextBlock Text="{Binding Nvme.StorageStatusText}" FontSize="11" Foreground="#666666" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel>
                          <StackPanel.Style>
                            <Style TargetType="StackPanel">
                              <Setter Property="Visibility" Value="Visible"/>
                              <Style.Triggers><DataTrigger Binding="{Binding ShowNvmeDiagnostics}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                          </StackPanel.Style>
                          <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" MinHeight="28" Padding="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Used" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Sata.UsedPercentDisplay}" FontSize="12" Foreground="#000000" TextWrapping="Wrap" TextTrimming="None" MaxWidth="160" HorizontalAlignment="Right"/></Grid></Border>
                          <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" MinHeight="28" Padding="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Total" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Sata.TotalStorageDisplay}" FontSize="12" Foreground="#000000" TextWrapping="Wrap" TextTrimming="None" MaxWidth="160" HorizontalAlignment="Right"/></Grid></Border>
                          <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" MinHeight="28" Padding="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Free" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Sata.FreeStorageDisplay}" FontSize="12" Foreground="#000000" TextWrapping="Wrap" TextTrimming="None" MaxWidth="160" HorizontalAlignment="Right"/></Grid></Border>
                          <TextBlock Text="{Binding Sata.StorageStatusText}" FontSize="11" Foreground="#666666" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>
      <Border Grid.Row="2" Background="#000000"><Grid Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Live Read - No Hardcode" Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding DashboardFooter}" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
