<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="DiagnosticCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="CornerRadius" Value="6"/></Style>
  <Style x:Key="AssessmentCard" TargetType="Border" BasedOn="{StaticResource DiagnosticCard}">
    <Setter Property="Background" Value="#F1F5F9"/><Setter Property="BorderBrush" Value="#CBD5E1"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Result.Assessment.State}" Value="NoIssuesDetected"><Setter Property="Background" Value="#EFFAF5"/><Setter Property="BorderBrush" Value="#9CD4B8"/></DataTrigger>
      <DataTrigger Binding="{Binding Result.Assessment.State}" Value="Attention"><Setter Property="Background" Value="#FFF8E8"/><Setter Property="BorderBrush" Value="#E7C577"/></DataTrigger>
      <DataTrigger Binding="{Binding Result.Assessment.State}" Value="Warning"><Setter Property="Background" Value="#FFF8E8"/><Setter Property="BorderBrush" Value="#E7C577"/></DataTrigger>
      <DataTrigger Binding="{Binding Result.Assessment.State}" Value="Critical"><Setter Property="Background" Value="#FFF1F2"/><Setter Property="BorderBrush" Value="#E5A3AC"/></DataTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="18,8"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="Foreground" Value="#25364D"/><Setter Property="Background" Value="#F1F5F9"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="BorderBrush" Value="#718EB9"/><Setter Property="Background" Value="White"/></Trigger></Style.Triggers></Style>
</ResourceDictionary>
